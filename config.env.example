# ---- docker-compose substitution vars ----
MONGO_ROOT_USER=change_me
MONGO_ROOT_PASSWORD=change_me
ME_CONFIG_BASICAUTH_USERNAME=change_me
ME_CONFIG_BASICAUTH_PASSWORD=change_me

# ---- app container vars (injected via env_file in docker-compose.yml) ----
NODE_ENV=development
PORT=5000
JWT_SECRET_KEY=change_me
JWT_EXPIRE_TIME=7d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=change_me
EMAIL_PASSWORD=change_me
